// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password  String
    role      String   @default("user")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Product {
    id              String                  @id @default(uuid())
    title           String
    description     String?
    handle          String                  @unique
    thumbnail       String?
    images          String[]
    categories      Category[]
    characteristics ProductCharacteristic[]
    price           Float                   @default(0)
    tags            String[]
    active          Boolean                 @default(false)
    createdAt       DateTime                @default(now())
    updatedAt       DateTime                @updatedAt
}

model ProductCharacteristic {
    id        String   @id @default(uuid())
    productId String
    product   Product  @relation(fields: [productId], references: [id])
    key       String
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([productId, key])
}

model Category {
    id          String     @id @default(uuid())
    name        String
    handle      String     @unique
    description String?
    thumbnail   String?
    active      Boolean    @default(true)
    parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
    parentId    String?
    children    Category[] @relation("CategoryToCategory")
    products    Product[]
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
}

model BlogPost {
    id          String   @id @default(uuid())
    views       Int      @default(0)
    title       String
    handle      String   @unique
    description String?
    seoTitle    String?
    thumbnail   String?
    body        Json?
    author      String?
    draft       Boolean  @default(true)
    type        String   @default("article")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Address {
    id        String      @id @default(uuid())
    type      AddressType // "zags", "morgue", "cemetery"
    name      String
    address   String?
    phone     String?
    schedule  String?
    district  String?
    location  String?
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
    active    Boolean     @default(true)
}

model Service {
    id               String   @id @default(uuid())
    handle           String   @unique
    title            String
    shortDescription String?
    description      String
    icon             String?
    thumbnail        String?
    images           String[]
    price            String
    duration         String?
    features         String[]
    included         String[]
    active           Boolean  @default(true)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
}

model PricePlan {
    id          String   @id @default(uuid())
    title       String
    description String
    price       String
    creditPrice String?
    popular     Boolean  @default(false)
    included    String[]
    order       Int      @default(0)
    active      Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model SiteSettings {
    id         String   @id @default(uuid())
    key        String   @unique @default("default")
    phone      String
    email      String
    address    String
    footerNote String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

enum AddressType {
    zags
    morgue
    cemetery
}
